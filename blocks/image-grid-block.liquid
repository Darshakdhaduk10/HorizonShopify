<!-- blocks/image-grid-block.liquid - FULL COPY-PASTE READY -->
<div class="row align-items-center">
    {% if block.settings.image1 %}
      <div class="col-6 col-md-4 col-lg">
        <div class="fashion-img {{ block.settings.image1_size }}">
          {{ block.settings.image1 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'img-fluid w-100 d-block' }}
        </div>
      </div>
    {% endif %}
  
    {% if block.settings.image2 %}
      <div class="col-6 col-md-4 col-lg">
        <div class="fashion-img {{ block.settings.image2_size }}">
          {{ block.settings.image2 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'img-fluid w-100 d-block' }}
