{% comment %} <div class="col-12 col-xl-3">
    <div class="left-deal-timer" {{ block.shopify_attributes }}>

        <h2 class="fs-46 mb-4 text-center text-start-xl-start">
            {{ block.settings.heading }}
        </h2>

        <p class="fs-16 mb-4 font-poppins text-center text-start-xl-start">
            {{ block.settings.description }}
        </p>

        <div class="d-flex justify-content-center justify-content-xl-start">
            <a href="{{ block.settings.button_link }}" class="btn-primary mb-5">
                {{ block.settings.button_text }}
            </a>
        </div>

        <p class="font-poppins fs-28 mb-4 text-center text-start-xl-start">
            {{ block.settings.timer_text }}
        </p>

        <div class="timer-btns d-flex justify-content-center justify-content-xl-start flex-wrap">
            <div class="timer-1 d-flex flex-column align-items-center">
                <div class="timer-time bg-white mb-3">
                    <span class="fs-32 font-poppins">02</span>
                </div>
                <span class="fs-24 font-poppins">Days</span>
            </div>

            <div class="timer-1 d-flex flex-column align-items-center">
                <div class="timer-time bg-white mb-3">
                    <span class="fs-32 font-poppins">06</span>
                </div>
                <span class="fs-24 font-poppins">Hr</span>
            </div>

            <div class="timer-1 d-flex flex-column align-items-center">
                <div class="timer-time bg-white mb-3">
                    <span class="fs-32 font-poppins">05</span>
                </div>
                <span class="fs-24 font-poppins">Mins</span>
            </div>

            <div class="timer-1 d-flex flex-column align-items-center">
                <div class="timer-time bg-white mb-3">
                    <span class="fs-32 font-poppins">30</span>
                </div>
                <span class="fs-24 font-poppins">Sec</span>
            </div>
        </div>

    </div>
</div>

{% schema %}
{
  "name": "Deal Left Content",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deals Of The Month" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Buy Now" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "text", "id": "timer_text", "label": "Timer Text", "default": "Hurry, Before It’s Too Late!" }
  ]
}
{% endschema %} {% endcomment %}










