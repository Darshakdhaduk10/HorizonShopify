<!-- ULTIMATE CENTER CONTENT COLUMN -->
<div class="col-12 col-md-4">
  <div class="center-box text-center d-flex flex-column align-items-center h-100" {{ block.shopify_attributes }}>

    {% if block.settings.top_image != blank %}
      <img
        src="{{ block.settings.top_image | image_url: width: 400 }}"
        alt="top-img"
        width=""
        height=""
        class="img-fluid mb-4">
    {% endif %}

    <h2 class="ultimate-heading mt-10">
      {{ block.settings.heading }}
      <span class="d-block">{{ block.settings.sub_heading }}</span>
    </h2>

    <p class="fs-20 mb-37">
      {{ block.settings.tagline }}
    </p>

    {% if block.settings.button_text != blank %}
      {% comment %} <button> {% endcomment %}
        <a href="{{ block.settings.button_link }}" class="btn-primary mb-5">
         {{ block.settings.button_text }}
       </a>
      {% comment %} </button> {% endcomment %}
      
    {% endif %}

    {% if block.settings.bottom_image != blank %}
      <img
        src="{{ block.settings.bottom_image | image_url: width: 400 }}"
        alt="bottom-img"
        width=""
        height=""
        class="img-fluid">
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Ultimate Center Content",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ULTIMATE"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "SALE"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Bottom Image"
    }
  ],
  "presets": [
    {
      "name": "Ultimate Center Content"
    }
  ]
}
{% endschema %}

