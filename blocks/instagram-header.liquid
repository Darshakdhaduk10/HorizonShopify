<!-- blocks/instagram-header.liquid - FULL COPY-PASTE READY -->
{% comment %} <div class="container text-center"> {% endcomment %}
    {% if block.settings.title != blank %}
      <h2 class="fs-46 mb-4 w-100 text-center">{{ block.settings.title }}</h2>
    {% endif %}
    
    {% if block.settings.description != blank %}
      <div class="w-100 d-flex justify-content-center text-center mb-5">
        <p class="fs-16 mw-30 font-poppins">{{ block.settings.description }}</p>
      </div>
    {% endif %}
  {% comment %} </div> {% endcomment %}
  
  {% schema %}
  {
    "name": "Instagram Header",
    "tag": "div",
    "class": "instagram-header-section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading Title",
        "default": "Follow Us On Instagram"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description Text",
        "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Scelerisque duis ultrices sollicitudin aliquam sem. Scelerisque duis ultrices sollicitudin"
      }
    ],
    "presets": [
      {
        "name": "Instagram Header"
      }
    ]
  }
  {% endschema %}
  