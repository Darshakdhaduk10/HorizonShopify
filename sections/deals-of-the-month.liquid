{% comment %} <section>
  <div class="container pe-sm-0">
    <div class="row timer-bg justify-content-end row-gap-5">

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'deal-left' %}
            {% render block %}
          {% when 'deal-arrows' %}
            {% render block %}
          {% when 'deal-slider' %}
            {% render block %}
        {% endcase %}
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Deals Of The Month",
  "blocks": [
    {
      "type": "deal-left",
      "name": "Left Content"
    },
    {
      "type": "deal-arrows",
      "name": "Slider Arrows"
    },
    {
      "type": "deal-slider",
      "name": "Right Slider"
    }
  ],
  "presets": [
    {
      "name": "Deals Of The Month"
    }
  ]
}
{% endschema %} {% endcomment %}


<section class="ultimate-wrapper py-5">
  <div class="container pe-sm-0">
    <div class="row timer-bg justify-content-end row-gap-5">

      {% for block in section.blocks %}
        {% render block %}
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ultimate Wrapper Banner",
  "blocks": [
    { "type": "@theme" }
  ],
  "presets": [
    { "name": "Deals Of The Month" }
  ]
}
{% endschema %}