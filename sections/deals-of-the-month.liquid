<section class="py-5">
  <div class="container pe-sm-0">
    <div class="row timer-bg justify-content-end row-gap-5">

      {% for block in section.blocks %}
        {% render block %}
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ultimate Wrapper Banner",
  "blocks": [
    { "type": "@theme" }
  ],
  "presets": [
    { "name": "Deals Of The Month" }
  ]
}
{% endschema %}